// Superead PostgreSQL Database Schema (Supabase / Prisma ORM)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                @id @default(uuid())
  email              String                @unique
  name               String?
  current_wpm        Int                   @default(220)
  baseline_wpm       Int                   @default(220)
  comprehension_rate Int                   @default(75)
  streak_days        Int                   @default(1)
  created_at         DateTime              @default(now())

  exercise_logs      ExerciseLog[]
  reading_progress   UserReadingProgress[]

  @@map("users")
}

model Book {
  id                      String                  @id @default(uuid())
  title                   String
  author                  String
  category                String
  difficulty_level        String
  word_count              Int
  content                 Json                    // Array of paragraph strings
  created_at              DateTime                @default(now())

  comprehension_questions ComprehensionQuestion[]
  reading_progress        UserReadingProgress[]

  @@map("books")
}

model ComprehensionQuestion {
  id             String @id @default(uuid())
  book_id        String
  question_text  String
  options        Json   // Array of 4 option strings
  correct_option Int    // 0-indexed

  book           Book   @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@map("comprehension_questions")
}

model ExerciseLog {
  id               String   @id @default(uuid())
  user_id          String
  exercise_type    String   // rsvp | pacer | schulte | speed_test | peripheral
  achieved_wpm     Int
  accuracy_score   Int
  duration_seconds Int
  completed_at     DateTime @default(now())

  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("exercise_logs")
}

model UserReadingProgress {
  id                 String   @id @default(uuid())
  user_id            String
  book_id            String
  current_word_index Int      @default(0)
  reading_mode       String   @default("standard") // standard | rsvp | pacer
  preferred_wpm      Int      @default(300)
  updated_at         DateTime @updatedAt

  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  book               Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([user_id, book_id])
  @@map("user_reading_progress")
}
